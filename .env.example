# Copy this file to .env and adjust values as needed.

# Server
HOST=0.0.0.0
PORT=8000

# Database – absolute or relative path to the SQLite file
DB_PATH=./data/jobs.db

# Scheduler – interval in hours between full scrape runs
SCRAPE_INTERVAL_HOURS=6

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/scraper.log

# Scraper tuning (seconds)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# ── LLM Evaluation pipeline ───────────────────────────────────────────────
# Groq API key (get one free at https://console.groq.com)
# Model used: llama-3.1-8b-instant (Stage 1 Critic + query generation)
GROQ_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys)
# Model used: gpt-4o (Stage 2 Decider)
OPENAI_API_KEY=

# GitHub Personal Access Token with `models:read` scope
# Used for GitHub Models (Azure AI Inference endpoint) powering two agents:
#   - Ministral-3B              : job metadata sanitisation (scraper post-processing)
#   - Cohere-command-r-08-2024  : company legitimacy verification (external jobs)
# Create one at: https://github.com/settings/tokens
# Both agents degrade gracefully to no-ops if this token is absent.
GITHUB_TOKEN=

# Absolute or relative path to your resume PDF
RESUME_PDF_PATH=./resume.pdf

# Optional: override LLM-generated search queries with a fixed comma-separated list.
# When set, the query generator skips the Groq API call entirely.
# Example: SEARCH_TERMS_OVERRIDE=Backend Java Intern,AI Engineer Intern,Data Science Intern
SEARCH_TERMS_OVERRIDE=

# How many unscored jobs to evaluate per batch run
EVAL_BATCH_SIZE=50

# Max concurrent LLM calls (Groq + OpenAI pair per job).
# Keep <=3 to stay safely within free-tier rate limits.
EVAL_CONCURRENCY=3
